# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, bypasses RLS, never expose to the browser
GEMINI_API_KEY=                       # https://aistudio.google.com/apikey (free tier data may be used by Google)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# WhatsApp Cloud API (optional). Without these the webhook still verifies but does not reply.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=             # for example v23.0, check Meta's current version
